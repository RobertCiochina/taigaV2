               <widget class="QCheckBox" name="checkTorrentDownloadUseMagnet">
                <property name="text">
                 <string>Prefer magnet links when both a magnet and a .torrent URL are present</string>
                </property>
                <property name="toolTip">
                 <string>Taiga v1: rss/torrent/options/downloadusemagnet. When off, double-click / primary actions use the HTTP(S) .torrent URL first (if any).</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QGroupBox" name="groupTorrentHandling">
             <property name="title">
              <string>Torrent client &amp; download rules (Taiga v1)</string>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_torrentHandling">
              <item>
               <widget class="QLabel" name="labelTorrentHandlingHelp">
                <property name="text">
                 <string>Folder rules are used when Taiga hands torrents to a client with a save path (full download manager parity is still in progress). “Custom executable” matches v1 rss/torrent/application.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkTorrentUseAnimeFolder">
                <property name="text">
                 <string>Use anime library folder as download target when available</string>
                </property>
                <property name="toolTip">
                 <string>Taiga v1: rss/torrent/options/autosetfolder</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkTorrentFallbackClientPath">
                <property name="text">
                 <string>If no per-title folder, use “Client download folder” from above</string>
                </property>
                <property name="toolTip">
                 <string>Taiga v1: rss/torrent/options/autousefolder</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkTorrentCreateSubfolder">
                <property name="text">
                 <string>Create a subfolder by anime title under that client download folder</string>
                </property>
                <property name="toolTip">
                 <string>Taiga v1: rss/torrent/options/autocreatefolder</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="checkTorrentAppOpen">
                <property name="text">
                 <string>Open torrents with an application (after download / when launching)</string>
                </property>
                <property name="toolTip">
                 <string>Taiga v1: rss/torrent/application/open</string>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_torrentAppMode">
                <item>
                 <widget class="QRadioButton" name="radioTorrentAppDefault">
                  <property name="text">
                   <string>Default application (.torrent / magnet handler)</string>
                  </property>
                  <property name="checked">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QRadioButton" name="radioTorrentAppCustom">
                  <property name="text">
                   <string>Custom executable</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <spacer name="horizontalSpacer_torrentAppMode">
                  <property name="orientation">
                   <enum>Qt::Horizontal</enum>
                  </property>
                  <property name="sizeHint" stdset="0">
                   <size>
                    <width>40</width>
                    <height>20</height>
                   </size>
                  </property>
                 </spacer>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_torrentAppExe">
                <item>
                 <widget class="QLineEdit" name="lineTorrentAppExecutable">
                  <property name="placeholderText">
                   <string>Path to qBittorrent.exe, etc.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="buttonBrowseTorrentAppExecutable">
                  <property name="text">
                   <string>Browse…</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="libraryStartupHintLabel">
             <property name="text">
              <string>Tip: You can also enable “Scan library folders when Taiga starts” on the Application page.</string>
