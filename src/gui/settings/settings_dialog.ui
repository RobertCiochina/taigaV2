              </item>
              <item row="2" column="1">
               <widget class="QComboBox" name="comboListMiddleClick"/>
              </item>
              <item row="3" column="0" colspan="2">
               <widget class="QCheckBox" name="checkListProgressShowAired">
                <property name="text">
                 <string>Show airing progress (thin strip on the progress bar)</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item row="4" column="0" colspan="2">
               <widget class="QCheckBox" name="checkListProgressShowAvailable">
                <property name="text">
